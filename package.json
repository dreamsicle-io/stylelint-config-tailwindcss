{
	"name": "@dreamsicle.io/stylelint-config-tailwindcss",
	"version": "1.3.2",
	"description": "A stylelint configuration for Tailwind CSS projects.",
	"main": "dist/stylelint.config.mjs",
	"files": [
		"package.json",
		"dist",
		"README.md",
		"LICENSE"
	],
	"homepage": "https://github.com/dreamsicle-io/stylelint-config-tailwindcss",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dreamsicle-io/stylelint-config-tailwindcss.git"
	},
	"bugs": {
		"url": "https://github.com/dreamsicle-io/stylelint-config-tailwindcss/issues"
	},
	"keywords": [
		"tailwind",
		"tailwindcss",
		"stylelint",
		"stylelint-config"
	],
	"author": "Dreamsicle",
	"license": "MIT",
	"scripts": {
		"start": "rollup -c --watch",
		"build": "rollup -c",
		"test": "stylelint -f verbose \"tests/**/*.css\"",
		"fix": "npm test -- --fix",
		"clean": "npm run clean:build; npm run clean:deps",
		"clean:build": "rm -rf dist; rm -rf syntax",
		"clean:deps": "rm -rf node_modules package-lock.json"
	},
	"peerDependencies": {
		"stylelint": "^16.17.0 || ^17.0.0 || ^18.0.0"
	},
	"devDependencies": {
		"@csstools/css-syntax-patches-for-csstree": "^1.1.16",
		"@rollup/plugin-commonjs": "29.0.3",
		"@rollup/plugin-json": "6.1.0",
		"@rollup/plugin-node-resolve": "16.0.3",
		"css-tree": "^3.2.1",
		"rollup": "4.67.5",
		"stylelint": "^18.0.0",
		"stylelint-config-standard": "^41.0.0"
	}
}
